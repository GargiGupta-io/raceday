# Raceday Environment Variables
# Copy this file to .env and fill in values as needed

# Data storage paths (defaults work for local development)
CACHE_DIR=./data/cache
INDEX_DIR=./data/index

# --- Radio Transcription (optional) ---
# Audio playback works without any keys. Transcription adds text to clips.
# Backends are tried in order: Groq → OpenAI → local whisper

# Groq (FREE tier, recommended)
# Sign up at https://console.groq.com → API Keys → Create
# Free tier: 14,400 audio-second/day (~240 clips)
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# OpenAI (paid, $0.006/minute)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# --- Frontend ---
# Set this when deploying (not needed for local dev)
# NEXT_PUBLIC_API_URL=https://your-backend-url.com
