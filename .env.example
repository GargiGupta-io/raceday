# Raceday Environment Variables
# Copy this file to .env and fill in values as needed

# Data storage paths (defaults work for local development)
CACHE_DIR=./data/cache
INDEX_DIR=./data/index

# Storage backend. JSON remains the current race-data production path.
STORAGE_BACKEND=json
# DATABASE_URL=postgresql://user:password@host:5432/raceday

# --- Radio Transcription (optional) ---
# Audio playback works without any keys. Transcription adds text to clips.
# Backends are tried in order: Groq → OpenAI → local whisper

# Groq (FREE tier, recommended)
# Sign up at https://console.groq.com → API Keys → Create
# Free tier: 14,400 audio-second/day (~240 clips)
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# OpenAI (paid, $0.006/minute)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# --- Frontend ---
# Set these when deploying (not needed for local dev)
# NEXT_PUBLIC_API_URL=https://your-backend-url.com
# NEXT_PUBLIC_SITE_URL=https://raceday-khaki.vercel.app
# NEXT_PUBLIC_LOOM_URL=https://www.loom.com/share/7df534de3e6848f094580612fe1341e7

# --- Backend deployment ---
# Comma-separated list of allowed frontend origins for CORS.
# FRONTEND_URLS=https://raceday-khaki.vercel.app,https://your-portfolio.com

# --- Runtime reliability (optional) ---
# Leave REDIS_URL unset to use the built-in in-memory cache.
# REDIS_URL=redis://user:password@host:6379/0
# Use a private stable value when multiple backend instances share Redis.
# RATE_LIMIT_SALT=replace-with-a-random-private-value
# RATE_LIMIT_COMPANION_PER_MINUTE=120
# RATE_LIMIT_ANALYSIS_PER_MINUTE=30
# RATE_LIMIT_SIMULATION_PER_MINUTE=60
# RATE_LIMIT_REFRESH_PER_HOUR=6

# Persist sanitized reliability events to PostgreSQL. Both values are required.
# Race data still uses the JSON index when this is enabled.
# RELIABILITY_EVENTS_ENABLED=true
# RELIABILITY_EVENT_QUEUE_SIZE=500
